---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

import { useTranslations } from "@/i18n";
import Socials from "@/components/Socials.astro";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const { socials, posts: postsConfig } = config;
const contact = await getEntry("pages", "contact");

if (!contact) {
  throw new Error(
    "Missing content entry: `contact.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(contact);
---

<Layout
  title={`${contact.data.title} | ${config.site.title}`}
  description={contact.data.description}
  ogImage={contact.data.ogImage}
  canonicalURL={contact.data.canonicalURL}
>

 <Header />
 <Breadcrumb />

 <!--  <Main pageTitle={about.data.title} class="app-prose"> -->

<Main pageTitle="how to reach me ..." class="app-prose"> 
	  <p>You can reach me through: <Socials /> </p>

		  <p>Or send an email to: <i>mail[at]johith[dot]com</i> </p>
 <!--  <Content /> -->

 </Main>



  <Footer />
</Layout>
